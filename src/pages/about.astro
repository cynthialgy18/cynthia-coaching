---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout title={`About | ${site.name} — Life Coach`} description="Learn about Cynthia's journey from burned-out professional to ICF PCC certified life coach.">

  <section class="page-hero">
    <div class="container">
      <p class="section-label">My Story</p>
      <h1>The Coach Behind the Journey</h1>
      <p>I didn't start out as a life coach — I started out just like you. Here's how a personal crisis became my greatest gift.</p>
    </div>
  </section>

  <!-- STORY -->
  <section class="section">
    <div class="container">
      <div class="about-story fade-up">
        <div class="about-story-img">
          <img src="/images/headshot-5.jpg" alt="Cynthia — Life Coach" style="width:100%;height:100%;object-fit:cover;" />
        </div>
        <div>
          <p class="section-label">My Background</p>
          <h2>From Burned Out to Breaking Free</h2>
          <p style="margin-bottom:1.2rem;">For years I did everything "right." Prestigious job, steady promotions, a packed schedule that left no room to breathe. On the outside, I was thriving. On the inside, I was running on empty — and I had no idea why.</p>
          <p style="margin-bottom:1.2rem;">The turning point came when I realised I couldn't remember the last time I felt genuinely excited about my work — or my life. That quiet, terrifying moment of clarity changed everything.</p>
          <p style="margin-bottom:1.2rem;">I spent the next few years doing the hard inner work: coaching, reflecting, learning. I discovered the frameworks and practices that actually move the needle. And I found my calling: helping others navigate the same crossroads with less confusion and more courage.</p>
          <p>Today, I'm an ICF PCC certified life coach helping mid-career adults — people in their 30s, 40s, and 50s — rediscover what matters, shed what doesn't, and build lives they're proud of.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CREDENTIALS -->
  <section class="section-sm bg-card">
    <div class="container">
      <div class="section-header center fade-up">
        <p class="section-label">Credentials</p>
        <h2>Trained, Certified & Committed</h2>
      </div>
      <div class="fade-up" style="display:flex;justify-content:center;margin:2rem 0 2.5rem;">
        <div style="text-align:center;">
          <img src="/images/pcc-badge.png" alt="ICF PCC — Professional Certified Coach" style="width:140px;height:140px;object-fit:contain;filter:drop-shadow(0 4px 12px rgba(0,0,0,.12));" />
          <p style="font-size:.8rem;color:var(--text-light);margin-top:.5rem;letter-spacing:.06em;text-transform:uppercase;">Verified Credential</p>
        </div>
      </div>
      <div class="credentials fade-up" style="max-width:800px;margin:0 auto;">
        <div class="credential-item">
          <span class="credential-icon">🎓</span>
          <div><strong>ICF Accredited Coach — PCC Level</strong><span>International Coaching Federation</span></div>
        </div>
        <div class="credential-item">
          <span class="credential-icon">🧠</span>
          <div><strong>NLP Practitioner</strong><span>Neuro-Linguistic Programming</span></div>
        </div>
        <div class="credential-item">
          <span class="credential-icon">🌿</span>
          <div><strong>Mindfulness-Based Coaching</strong><span>Certified practitioner</span></div>
        </div>
        <div class="credential-item">
          <span class="credential-icon">💼</span>
          <div><strong>Corporate Leadership Experience</strong><span>Strategy & Leadership roles</span></div>
        </div>
        <div class="credential-item">
          <span class="credential-icon">🌍</span>
          <div><strong>200+ Clients Worldwide</strong><span>Across multiple countries</span></div>
        </div>
        <div class="credential-item">
          <span class="credential-icon">📅</span>
          <div><strong>7+ Years Coaching Experience</strong><span>Since 2018</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="section">
    <div class="container">
      <div class="section-header center fade-up">
        <p class="section-label">How I Work</p>
        <h2>The Principles I Coach By</h2>
        <p>These aren't just words on a page — they're the foundation of every single session.</p>
      </div>
      <div class="values-grid fade-up">
        {[
          { icon: "🧭", title: "Radical Clarity", desc: "We cut through the noise together. No vague goals — only honest, precise insight into what you truly want and why." },
          { icon: "❤️", title: "Deep Compassion", desc: "This work requires vulnerability. I hold space with warmth and zero judgement, so you always feel safe." },
          { icon: "⚡", title: "Brave Action", desc: "Insight is only the beginning. I'm here to help you move — thoughtfully, boldly, in full alignment with who you're becoming." },
          { icon: "🔁", title: "Whole-Life Thinking", desc: "Career, relationships, health, identity — they're all connected. We look at the full picture, not just the symptom." },
          { icon: "🌱", title: "Sustainable Growth", desc: "No quick fixes. We build changes that last — rooted in who you are, not who you think you should be." },
          { icon: "🎯", title: "Your Agenda", desc: "You lead. I guide. Every session centres on what matters most to you right now." },
        ].map(v => (
          <div class="value-card">
            <div class="value-icon">{v.icon}</div>
            <h4>{v.title}</h4>
            <p>{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <p class="section-label">Let's Connect</p>
      <h2>Curious If We'd Work Well Together?</h2>
      <p>Book a free, relaxed 30-minute discovery call — no pressure, no pitch.</p>
      <div class="cta-btns">
        <a href="/contact" class="btn btn-white">Book My Free Call</a>
        <a href="/services" class="btn btn-outline" style="border-color:rgba(255,255,255,.3);color:#fff;">Explore Services</a>
      </div>
    </div>
  </section>

</Layout>
