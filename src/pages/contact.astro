---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout title={`Book a Call | ${site.name} — Relational Coach`} description="Book a complimentary 20-minute discovery call with Cynthia or send a message. Let's explore what's possible for you.">

  <section class="page-hero">
    <div class="container">
      <p class="section-label">Let's Talk</p>
      <h1>Start the Conversation</h1>
      <p>Send me a message and I'll be in touch. No pressure, no pitch — just an honest conversation about what's possible for you.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid">

        <!-- LEFT: Info -->
        <div class="contact-info fade-up">
          <p class="section-label">What to Expect</p>
          <h3>The Discovery Call</h3>
          <p>A genuine, 20-minute conversation — useful whether we end up working together or not.</p>

          <div style="display:flex;flex-direction:column;gap:14px;margin:1.8rem 0 2rem;">
            {[
              { n:"1", title:"Where are you right now?",  desc:"We'll honestly assess your current situation — what's working, what isn't." },
              { n:"2", title:"What do you really want?",  desc:"We'll get underneath surface goals to what truly matters to you." },
              { n:"3", title:"Could coaching help?",      desc:"I'll give you an honest view — and only invite you to work together if I genuinely think I can help." },
            ].map(s => (
              <div style="display:flex;gap:14px;align-items:flex-start;">
                <div style="width:36px;height:36px;border-radius:50%;background:var(--bg-card);border:2px solid var(--accent);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;color:var(--accent);font-weight:700;flex-shrink:0;">{s.n}</div>
                <div>
                  <strong style="display:block;font-size:.95rem;margin-bottom:3px;">{s.title}</strong>
                  <span style="font-size:.88rem;color:var(--text-light);">{s.desc}</span>
                </div>
              </div>
            ))}
          </div>


          <div style="background:var(--bg-card);border-radius:var(--radius);padding:24px;border-left:4px solid var(--accent);">
            <p style="font-family:'Playfair Display',serif;font-style:italic;font-size:.95rem;color:var(--text);margin-bottom:12px;">"I almost didn't book the call because I thought I wasn't 'ready.' Best decision I ever made. Just book it."</p>
            <span style="font-size:.82rem;color:var(--text-light);">— Coaching Client</span>
          </div>
        </div>

        <!-- RIGHT: Form -->
        <div class="fade-up">
          <div class="contact-form-card">
            <h3>Send Me a Message</h3>
            <div data-fs-success style="display:none;text-align:center;padding:40px 20px;">
              <div style="font-size:2.5rem;margin-bottom:16px;">✓</div>
              <h3 style="margin-bottom:.5rem;">Message received.</h3>
              <p style="color:var(--text-light);">I'll be in touch soon.</p>
            </div>
            <div data-fs-error style="display:none;color:#c0392b;font-size:.88rem;margin-bottom:12px;padding:12px;background:#fdf0ee;border-radius:var(--radius-sm);"></div>
            <form id="contactForm">
              <div class="form-row">
                <div class="form-group">
                  <label for="firstName">First Name</label>
                  <input type="text" id="firstName" name="firstName" placeholder="Jane" required data-fs-field />
                  <span data-fs-error="firstName" style="font-size:.8rem;color:#c0392b;"></span>
                </div>
                <div class="form-group">
                  <label for="lastName">Last Name</label>
                  <input type="text" id="lastName" name="lastName" placeholder="Smith" required data-fs-field />
                  <span data-fs-error="lastName" style="font-size:.8rem;color:#c0392b;"></span>
                </div>
              </div>
              <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" placeholder="jane@example.com" required data-fs-field />
                <span data-fs-error="email" style="font-size:.8rem;color:#c0392b;"></span>
              </div>
              <div class="form-group">
                <label for="interest">What are you hoping to work on?</label>
                <select id="interest" name="interest" data-fs-field>
                  <option value="" disabled selected>Select an area…</option>
                  <option>Feeling stuck or unsure what's next</option>
                  <option>Figuring out who I am (identity &amp; values)</option>
                  <option>Reconnecting with what truly matters</option>
                  <option>Relationships — with myself or others</option>
                  <option>Career change or direction</option>
                  <option>Confidence &amp; self-belief</option>
                  <option>Something else</option>
                </select>
              </div>
              <div class="form-group">
                <label for="message">Tell me a little about where you are right now</label>
                <textarea id="message" name="message" placeholder="What's brought you here today?" required data-fs-field></textarea>
                <span data-fs-error="message" style="font-size:.8rem;color:#c0392b;"></span>
              </div>
              <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;" data-fs-submit-btn>Send Message →</button>
            </form>
          </div>

          <script>
            window.formspree = window.formspree || function () { (formspree.q = formspree.q || []).push(arguments); };
            formspree('initForm', { formElement: '#contactForm', formId: 'mvzywyge' });
          </script>
          <script src="https://unpkg.com/@formspree/ajax@1" defer></script>
        </div>

      </div>
    </div>
  </section>

</Layout>
