---
import Layout from '../layouts/Layout.astro';
import { site, services } from '../data/site';
---

<Layout title={`Services | ${site.name} — Life Coach`} description="1-on-1 life coaching and a free discovery call for mid-career adults ready to transform their lives.">

  <section class="page-hero">
    <div class="container">
      <p class="section-label">Services</p>
      <h1>Invest in Your Next Chapter</h1>
      <p>Every offering is designed to meet you where you are and take you somewhere better.</p>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section" id="one-on-one">
    <div class="container">
      <div class="section-header center fade-up">
        <p class="section-label">What I Offer</p>
        <h2>Simple, Focused, Transformative</h2>
        <p>No complicated packages — just meaningful coaching tailored to you.</p>
      </div>
      <div style="max-width:900px;margin:3rem auto 0;display:grid;gap:32px;">
        {services.map(s => (
          <div class={`service-card fade-up${s.featured ? ' featured' : ''}`} style="flex-direction:row;align-items:flex-start;gap:40px;padding:48px;">
            <div style="flex-shrink:0;text-align:center;min-width:140px;">
              <div style="font-size:3rem;margin-bottom:12px;">{s.icon}</div>
              <span class="service-badge" style={s.tagColor === 'green' ? 'background:var(--green)' : ''}>{s.tagline}</span>
            </div>
            <div style="flex:1;">
              <h2 style="font-size:1.8rem;margin-bottom:.75rem;">{s.title}</h2>
              <p style="margin-bottom:1.5rem;">{s.desc}</p>
              <ul class="service-features" style="margin-bottom:2rem;">
                {s.features.map(f => <li>{f}</li>)}
              </ul>
              <div style="display:flex;align-items:center;gap:2rem;flex-wrap:wrap;">
                <div>
                  <div class="service-price">{s.price} <span>{s.unit}</span></div>
                  <div style="font-size:.82rem;color:var(--text-light);margin-top:4px;">{s.note}</div>
                </div>
                <a href={s.ctaHref} class={`btn ${s.featured ? 'btn-primary' : 'btn-green'}`}>{s.cta}</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section bg-card">
    <div class="container">
      <div class="section-header center fade-up">
        <p class="section-label">The Process</p>
        <h2>How It Works</h2>
        <p>From first call to lasting change — here's what the journey looks like.</p>
      </div>
      <div class="process-steps">
        {[
          { n:"1", title:"Book a Free Call",     desc:"We spend 30 minutes getting to know each other. No pressure — just an honest conversation about where you are and where you want to go." },
          { n:"2", title:"Create Your Roadmap",  desc:"In your first paid session we map out your goals, identify what's been blocking you, and design your personalised coaching plan." },
          { n:"3", title:"Do the Work Together", desc:"Bi-weekly sessions, ongoing support, and powerful tools to help you gain clarity, build momentum, and take bold action." },
          { n:"4", title:"Live Your New Chapter",desc:"Watch the changes compound. Clients often describe it as 'finally feeling like themselves again.'" },
        ].map(s => (
          <div class="process-step fade-up">
            <div class="step-number">{s.n}</div>
            <h4>{s.title}</h4>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container" style="max-width:760px;">
      <div class="section-header center fade-up">
        <p class="section-label">Questions</p>
        <h2>Frequently Asked</h2>
      </div>
      <div style="margin-top:2.5rem;display:flex;flex-direction:column;gap:16px;" class="fade-up">
        {[
          { q:"Is life coaching the same as therapy?", a:"No — they're quite different. Therapy typically focuses on healing past wounds. Coaching focuses on your present situation and future goals. We work forward, not backward. If you need therapeutic support, I'll always refer you to the right resource." },
          { q:"How long does it take to see results?", a:"Many clients notice meaningful shifts in clarity and confidence within the first 2–3 sessions. Deeper, lasting change typically unfolds over 3–6 months. The timeline depends on what you're working on and how actively you engage between sessions." },
          { q:"Do sessions happen in person or online?", a:"All sessions are conducted online via video call (Zoom or your preferred platform). This means we can work together no matter where in the world you are." },
          { q:"What if coaching isn't right for me?", a:"That's exactly what the free discovery call is for. If I don't think I can genuinely help you, I'll tell you honestly — and point you toward something that can." },
        ].map(faq => (
          <details style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:24px;cursor:pointer;">
            <summary style="font-weight:700;font-size:1rem;color:var(--text);list-style:none;display:flex;justify-content:space-between;align-items:center;">
              {faq.q}
              <span style="font-size:1.3rem;color:var(--accent);font-weight:300;">+</span>
            </summary>
            <p style="margin-top:14px;font-size:.95rem;">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <p class="section-label">Start Today</p>
      <h2>The Best Time to Begin Was Yesterday. The Next Best Time Is Now.</h2>
      <p>Book a free discovery call and let's find out what's truly possible for you.</p>
      <div class="cta-btns">
        <a href="/contact" class="btn btn-white">Book My Free Call</a>
      </div>
    </div>
  </section>

</Layout>
