---
import Layout from '../layouts/Layout.astro';
import { site, services } from '../data/site';
---

<Layout title={`Services | ${site.name} — Relational Coach`} description="1-on-1 relational coaching and a complimentary discovery call for people who feel stuck, unsure what's next, and ready for meaningful change.">

  <section class="page-hero">
    <div class="container">
      <p class="section-label">Working With Cynthia</p>
      <h1>Not a Formula. A Real Conversation.</h1>
      <p>I'm not going to hand you a 12-step plan. I'm going to sit with you, figure out what's actually going on beneath the surface, and use everything in my toolbox to get you moving.</p>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section" id="one-on-one">
    <div class="container">
      <div class="section-header center fade-up">
        <p class="section-label">What I Offer</p>
        <h2>Simple. Real. No Fluff.</h2>
        <p>I don't do complicated packages or cookie-cutter programmes. What I do is show up fully — and work with what's real for you.</p>
      </div>
      <div style="max-width:900px;margin:3rem auto 0;display:grid;gap:32px;">
        {services.map(s => (
          <div class={`service-card fade-up${s.featured ? ' featured' : ''}`} style="flex-direction:row;align-items:flex-start;gap:40px;padding:48px;">
            <div style="flex-shrink:0;text-align:center;min-width:140px;">
              <div style="font-size:3rem;margin-bottom:12px;">{s.icon}</div>
              <span class="service-badge" style={s.tagColor === 'green' ? 'background:var(--green)' : ''}>{s.tagline}</span>
            </div>
            <div style="flex:1;">
              <h2 style="font-size:1.8rem;margin-bottom:.75rem;">{s.title}</h2>
              <p style="margin-bottom:1.5rem;">{s.desc}</p>
              <ul class="service-features" style="margin-bottom:2rem;">
                {s.features.map(f => <li>{f}</li>)}
              </ul>
              <div style="display:flex;align-items:center;gap:2rem;flex-wrap:wrap;">
                <div>
                  <div class="service-price">{s.price} <span>{s.unit}</span></div>
                  <div style="font-size:.82rem;color:var(--text-light);margin-top:4px;">{s.note}</div>
                </div>
                <a href={s.ctaHref} class={`btn ${s.featured ? 'btn-primary' : 'btn-green'}`}>{s.cta}</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section bg-card">
    <div class="container">
      <div class="section-header center fade-up">
        <p class="section-label">The Process</p>
        <h2>What Actually Happens</h2>
        <p>No fluff. Here's what the journey looks like from first call to coming out the other side.</p>
      </div>
      <div class="process-steps">
        {[
          { n:"1", title:"You Show Up. (That's the Hardest Part.)", desc:"Book the call. That's it. You don't need a goal statement or to have it figured out. You just need to show up — I'll meet you exactly where you are." },
          { n:"2", title:"We Go Below the Surface.",  desc:"Not just what's happening — but what's really happening. Who you are underneath all the roles. What you actually want. What's been quietly affecting the people closest to you. We go there together." },
          { n:"3", title:"You're Challenged. And Held.", desc:"I challenge you when you need it. You sit in the discomfort — I will create the space for you to examine it. This is a joint process: I bring the skills and the sharp eye; you bring the willingness to do the work." },
          { n:"4", title:"You Leave With More Clarity.", desc:"Each session, you walk away with more clarity than you came in with. What you do between sessions is where the real shift happens — and that part belongs to you." },
        ].map(s => (
          <div class="process-step fade-up">
            <div class="step-number">{s.n}</div>
            <h4>{s.title}</h4>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container" style="max-width:760px;">
      <div class="section-header center fade-up">
        <p class="section-label">Questions</p>
        <h2>Frequently Asked</h2>
      </div>
      <div style="margin-top:2.5rem;display:flex;flex-direction:column;gap:16px;" class="fade-up">
        {[
          { q:"Is relational coaching the same as therapy?", a:"No — quite different. Therapy typically works on healing from the past. Coaching works on where you are right now and where you're going. We work forward, not backward. If I sense you need therapeutic support, I'll always be honest about that and point you toward the right resource." },
          { q:"How quickly will I see a difference?", a:"Around 3 to 4 sessions in, most clients begin to notice real shifts — more clarity, more space, a different relationship with what's been weighing on them. Deeper changes take longer. It depends on what you're working through and how you show up. I can't guarantee outcomes — but I'll bring everything I have." },
          { q:"Do sessions happen in person or online?", a:"Sessions are via video call or phone call — whichever works for you." },
          { q:"What if you're not the right coach for me?", a:"Then I'll tell you. Honestly. The discovery call exists precisely for this — I'll give you my honest read on whether I think I can genuinely help, and if I can't, I'll tell you that too and point you toward someone who can." },
          { q:"I'm not sure I'm 'ready'. Should I still book?", a:"Yes. 'Not ready' is exactly who I work with. You don't need to have it figured out. You don't need a clear goal. You just need to be willing to have an honest conversation. That's enough to start." },
        ].map(faq => (
          <details style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:24px;cursor:pointer;">
            <summary style="font-weight:700;font-size:1rem;color:var(--text);list-style:none;display:flex;justify-content:space-between;align-items:center;">
              {faq.q}
              <span style="font-size:1.3rem;color:var(--accent);font-weight:300;">+</span>
            </summary>
            <p style="margin-top:14px;font-size:.95rem;">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <p class="section-label">Still on the Fence?</p>
      <h2>On the Verge and Not Sure? That's Exactly Who I Work With.</h2>
      <p>You don't need to have it all figured out. You just need to be willing to show up and look honestly at what's there. That's where we start.</p>
      <div class="cta-btns">
        <a href="/contact" class="btn btn-white">Book My Call</a>
      </div>
    </div>
  </section>

</Layout>
