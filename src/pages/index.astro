---
import Layout from '../layouts/Layout.astro';
import { site, services } from '../data/site';
import { testimonials } from '../data/testimonials';

const preview = testimonials.slice(0, 3);
---

<Layout title={`${site.name} | Life Coach for Mid-Career Transformation`} description={site.description}>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-content">
          <p class="section-label">Life Coaching</p>
          <h1>Your Next Chapter Starts <em>Here</em></h1>
          <p>Feeling stuck, burned out, or unsure of what's next? I help mid-career professionals in their 30s–50s rediscover their purpose, reclaim their energy, and build a life that actually excites them.</p>
          <div class="hero-btns">
            <a href="/contact" class="btn btn-primary">Book a Free Discovery Call</a>
            <a href="/about" class="btn btn-outline">Learn My Story</a>
          </div>
        </div>
        <div class="hero-image">
          <div class="hero-img-wrap">
            <img src="/images/headshot-6.jpg" alt="Cynthia — Life Coach" style="width:100%;height:100%;object-fit:cover;" />
          </div>
          <div class="hero-badge">
            <div class="hero-badge-icon">🌿</div>
            <div class="hero-badge-text">
              <strong>200+ Lives Transformed</strong>
              <span>Since 2018</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="trust-bar">
    <div class="trust-bar-inner">
      <div class="trust-item">
        <span class="trust-item-icon">🌟</span>
        <div><strong>200+</strong><span>Clients Coached</span></div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="trust-item-icon">📅</span>
        <div><strong>7+ yrs</strong><span>Experience</span></div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="trust-item-icon">✨</span>
        <div><strong>5-star</strong><span>Average Rating</span></div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <img src="/images/pcc-badge.png" alt="ICF PCC Badge" style="width:44px;height:44px;object-fit:contain;" />
        <div><strong>ICF PCC</strong><span>Accredited</span></div>
      </div>
    </div>
  </div>

  <!-- ABOUT TEASER -->
  <section class="section">
    <div class="container">
      <div class="about-teaser-inner">
        <div class="about-teaser-img">
          <img src="/images/headshot-4.jpg" alt="Cynthia" style="width:100%;height:100%;object-fit:cover;" />
        </div>
        <div class="about-teaser-text fade-up">
          <p class="section-label">About Me</p>
          <h2>I've Been Where You Are — And I Found the Way Through</h2>
          <p>After years climbing the corporate ladder, I woke up one morning feeling completely lost. I had the title, the salary, the "success" — but none of the fulfilment. That moment of crisis became the turning point that led me to coaching.</p>
          <p>Today, I help mid-career adults like you cut through the noise, reconnect with what truly matters, and create meaningful change — without starting over from scratch.</p>
          <div class="pillars">
            <div class="pillar"><div class="pillar-icon">🧭</div><div class="pillar-text"><strong>Clarity-first approach</strong><span>No fluff — we get real and get focused</span></div></div>
            <div class="pillar"><div class="pillar-icon">🤝</div><div class="pillar-text"><strong>A safe, judgment-free space</strong><span>Your story is met with compassion, always</span></div></div>
            <div class="pillar"><div class="pillar-icon">🚀</div><div class="pillar-text"><strong>Action-oriented results</strong><span>Insight is great — but change is the goal</span></div></div>
          </div>
          <a href="/about" class="btn btn-outline">More About Me →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES PREVIEW -->
  <section class="section bg-card">
    <div class="container">
      <div class="section-header center fade-up">
        <p class="section-label">What I Offer</p>
        <h2>Choose the Path That's Right for You</h2>
        <p>Whether you're ready to dive in or just want to explore, there's a starting point designed for exactly where you are.</p>
      </div>
      <div class="services-grid">
        {services.map(s => (
          <div class={`service-card fade-up${s.featured ? ' featured' : ''}`}>
            {s.featured && <span class="service-badge">{s.tagline}</span>}
            <div class="service-icon">{s.icon}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <ul class="service-features">
              {s.features.slice(0, 4).map(f => <li>{f}</li>)}
            </ul>
            <div class="service-price">{s.price} <span>{s.unit}</span></div>
            <a href={s.ctaHref} class={`btn ${s.featured ? 'btn-primary' : 'btn-green'}`}>{s.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS PREVIEW -->
  <section class="section">
    <div class="container">
      <div class="section-header center fade-up">
        <p class="section-label">Client Love</p>
        <h2>Real People. Real Transformations.</h2>
        <p>Here's what clients say after working together.</p>
      </div>
      <div class="testimonials-grid">
        {preview.map(t => (
          <div class="testimonial-card fade-up">
            <div class="testimonial-stars">★★★★★</div>
            <p class="testimonial-quote">{t.quote}</p>
            <div class="testimonial-author">
              <div class="testimonial-avatar">{t.avatar}</div>
              <div class="testimonial-author-info">
                <strong>{t.name}</strong>
                <span>{t.role}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:2.5rem;">
        <a href="/testimonials" class="btn btn-outline">Read All Stories →</a>
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="cta-banner">
    <div class="container">
      <p class="section-label">Ready to Begin?</p>
      <h2>Your Transformation Starts With One Conversation</h2>
      <p>Book a free, no-pressure discovery call and let's explore what's possible for you.</p>
      <div class="cta-btns">
        <a href="/contact" class="btn btn-white">Book My Free Call</a>
        <a href="/services" class="btn btn-outline" style="border-color:rgba(255,255,255,.3);color:#fff;">View Services</a>
      </div>
    </div>
  </section>

</Layout>
