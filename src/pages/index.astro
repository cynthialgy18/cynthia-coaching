---
import Layout from '../layouts/Layout.astro';
import { site, services } from '../data/site';
import { testimonials } from '../data/testimonials';

const preview = testimonials.slice(0, 3);
---

<Layout title={`${site.name} | Life Coach for Mid-Career Transformation`} description={site.description}>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-content">
          <p class="section-label">Life Coaching with Cynthia Lim</p>
          <h1>There's So Much More to You Than Your Current Situation.</h1>
          <p>You're not stuck. You're just collapsed. Somewhere underneath all the noise, there's a version of you that hasn't had the space to come out yet. A flicker of flame — that's all it takes to reset your soul ablaze. I'm here to help you find it.</p>
          <div class="hero-btns">
            <a href="/contact" class="btn btn-primary">Book a Free Discovery Call</a>
            <a href="/about" class="btn btn-outline">Learn My Story</a>
          </div>
        </div>
        <div class="hero-image">
          <div class="hero-img-wrap">
            <img src="/images/headshot-6.jpg" alt="Cynthia — Life Coach" style="width:100%;height:100%;object-fit:cover;" />
          </div>
          <div class="hero-badge">
            <div class="hero-badge-icon">🌿</div>
            <div class="hero-badge-text">
              <strong>200+ Lives Transformed</strong>
              <span>Since 2018</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="trust-bar">
    <div class="trust-bar-inner">
      <div class="trust-item">
        <span class="trust-item-icon">🌟</span>
        <div><strong>200+</strong><span>Clients Coached</span></div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="trust-item-icon">📅</span>
        <div><strong>7+ yrs</strong><span>Experience</span></div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="trust-item-icon">✨</span>
        <div><strong>5-star</strong><span>Average Rating</span></div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <img src="/images/pcc-badge.png" alt="ICF PCC Badge" style="width:44px;height:44px;object-fit:contain;" />
        <div><strong>ICF PCC</strong><span>Accredited</span></div>
      </div>
    </div>
  </div>

  <!-- ABOUT TEASER -->
  <section class="section">
    <div class="container">
      <div class="about-teaser-inner">
        <div class="about-teaser-img">
          <img src="/images/headshot-4.jpg" alt="Cynthia" style="width:100%;height:100%;object-fit:cover;" />
        </div>
        <div class="about-teaser-text fade-up">
          <p class="section-label">Who Is Cynthia?</p>
          <h2>A Bullsh*t Detector. With a Lot of Heart.</h2>
          <p>I'm not going to tell you time will heal. I'm not going to give you a formula or a pretty journal prompt. If you pay me and you need the truth — I'll tell you the truth. From what I see, what I sense, and sometimes what you're not yet ready to say out loud yourself.</p>
          <p>My clients call me authentic. I think what that means is: I'm not pretending. I show up fully, I push when you need a push, I pull when you're ready to move. And I will not let you stay stuck.</p>
          <div class="pillars">
            <div class="pillar"><div class="pillar-icon">🔍</div><div class="pillar-text"><strong>No bullsh*t, ever</strong><span>Honest conversations that actually move you</span></div></div>
            <div class="pillar"><div class="pillar-icon">🤝</div><div class="pillar-text"><strong>Challenged and held</strong><span>Uncomfortable questions — but never alone in them</span></div></div>
            <div class="pillar"><div class="pillar-icon">🔥</div><div class="pillar-text"><strong>A force, not a nudge</strong><span>I won't let you stay where you are</span></div></div>
          </div>
          <a href="/about" class="btn btn-outline">More About Me →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES PREVIEW -->
  <section class="section bg-card">
    <div class="container">
      <div class="section-header center fade-up">
        <p class="section-label">How I Work</p>
        <h2>Space to Get Sorted. Then to Stretch.</h2>
        <p>I work with people who are carrying something heavy — heart pain they haven't been able to air out. People on the verge, who haven't given up. Who know there's more, but can't quite see past where they are right now.</p>
      </div>
      <div class="services-grid">
        {services.map(s => (
          <div class={`service-card fade-up${s.featured ? ' featured' : ''}`}>
            {s.featured && <span class="service-badge">{s.tagline}</span>}
            <div class="service-icon">{s.icon}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <ul class="service-features">
              {s.features.slice(0, 4).map(f => <li>{f}</li>)}
            </ul>
            <div class="service-price">{s.price} <span>{s.unit}</span></div>
            <a href={s.ctaHref} class={`btn ${s.featured ? 'btn-primary' : 'btn-green'}`}>{s.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS PREVIEW -->
  <section class="section">
    <div class="container">
      <div class="section-header center fade-up">
        <p class="section-label">Client Stories</p>
        <h2>Real People. Real Change.</h2>
        <p>These aren't highlight reels. They're what happens when someone finally has a space to be honest — and decides to do something about it.</p>
      </div>
      <div class="testimonials-grid">
        {preview.map(t => (
          <div class="testimonial-card fade-up">
            <div class="testimonial-stars">★★★★★</div>
            <p class="testimonial-quote">{t.quote}</p>
            <div class="testimonial-author">
              <div class="testimonial-avatar">{t.avatar}</div>
              <div class="testimonial-author-info">
                <strong>{t.name}</strong>
                <span>{t.role}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:2.5rem;">
        <a href="/testimonials" class="btn btn-outline">Read All Stories →</a>
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="cta-banner">
    <div class="container">
      <p class="section-label">My Hand Is Waiting</p>
      <h2>You Don't Need to Be Ready. Just Show Up.</h2>
      <p class="poem-line">"What's rightfully yours will only be claimed when you embrace your power."</p>
      <p>I've had clients say they almost didn't book because they thought they weren't 'ready'. You don't need to be ready. You just need to show up — I'll meet you there.</p>
      <div class="cta-btns">
        <a href="/contact" class="btn btn-white">Book My Free Call</a>
        <a href="/services" class="btn btn-outline" style="border-color:rgba(250,246,240,.3);color:rgba(250,246,240,.9);">See How It Works</a>
      </div>
    </div>
  </section>

</Layout>
