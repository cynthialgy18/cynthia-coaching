---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} | ${site.name}`} description={post.data.description}>

  <section class="page-hero">
    <div class="container" style="max-width:760px;">
      <span class="blog-tag" style="margin-bottom:1rem;display:inline-block;">{post.data.tag}</span>
      <h1 style="font-size:clamp(1.8rem,4vw,2.8rem);">{post.data.title}</h1>
      <div style="display:flex;gap:16px;align-items:center;margin-top:1rem;font-size:.88rem;color:var(--text-light);">
        <span>📅 {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
        <span>⏱ {post.data.readTime}</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:760px;">
      <div class="prose fade-up">
        <Content />
      </div>
      <div style="margin-top:3rem;padding-top:2rem;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
        <a href="/blog" class="btn btn-outline">← Back to Blog</a>
        <a href="/contact" class="btn btn-primary">Book a Free Call</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .prose :global(h2) { font-family: 'Playfair Display', serif; font-size: 1.6rem; margin: 2rem 0 .75rem; color: var(--text); }
  .prose :global(h3) { font-family: 'Playfair Display', serif; font-size: 1.25rem; margin: 1.5rem 0 .5rem; color: var(--text); }
  .prose :global(p)  { color: var(--text-mid); line-height: 1.85; margin-bottom: 1.2rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5rem; margin-bottom: 1.2rem; }
  .prose :global(li) { color: var(--text-mid); line-height: 1.8; margin-bottom: .4rem; }
  .prose :global(strong) { color: var(--text); }
  .prose :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2rem 0; }
  .prose :global(em) { color: var(--text-mid); }
  .prose :global(blockquote) { border-left: 4px solid var(--accent); padding-left: 1.2rem; margin: 1.5rem 0; font-style: italic; color: var(--text-mid); }
</style>
