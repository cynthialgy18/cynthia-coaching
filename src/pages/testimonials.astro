---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { testimonials } from '../data/testimonials';

const featuredPool  = testimonials.filter(t => t.featured);
const coachingClients = testimonials.filter(t => t.type === 'coaching' && !t.featured);
const mentorClients   = testimonials.filter(t => t.type === 'mentor'   && !t.featured);
---

<Layout title={`Testimonials | ${site.name} — Life Coach`} description="Real stories from real people — hear what it looks like to feel stuck, do the work, and reconnect to what truly matters.">

  <section class="page-hero">
    <div class="container">
      <p class="section-label">Client Stories</p>
      <h1>Real People. Real Change.</h1>
      <p>These aren't highlight reels — they're honest accounts of what it looks like to do the work and come out the other side.</p>
    </div>
  </section>

  <div class="trust-bar">
    <div class="trust-bar-inner">
      <div class="trust-item">
        <img src="/images/pcc-badge.png" alt="ICF PCC Badge" style="width:44px;height:44px;object-fit:contain;" />
        <div><strong>ICF PCC</strong><span>Accredited</span></div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item"><span class="trust-item-icon">👥</span><div><strong>200+</strong><span>Clients Coached</span></div></div>
      <div class="trust-divider"></div>
      <div class="trust-item"><span class="trust-item-icon">⏱</span><div><strong>600+</strong><span>Hours Coached</span></div></div>
      <div class="trust-divider"></div>
      <div class="trust-item"><span class="trust-item-icon">📅</span><div><strong>10+ yrs</strong><span>Since 2015</span></div></div>
    </div>
  </div>

  <!-- ROTATING FEATURED — one shown per week via JS -->
  <section class="section">
    <div class="container">
      <div class="section-header center fade-up" style="margin-bottom:2rem;">
        <p class="section-label">Featured This Week</p>
      </div>
      <div id="featuredPool">
        {featuredPool.map((t, i) => (
          <div
            data-fi={i}
            style="display:none;background:linear-gradient(135deg,#FDF8F3,#F2E9DF);border:1px solid var(--border);border-radius:var(--radius);padding:56px;max-width:860px;margin:0 auto;text-align:center;"
            class="fade-up"
          >
            <div style="font-size:3.5rem;color:var(--accent);line-height:.8;margin-bottom:1rem;">"</div>
            <p style="font-family:'Playfair Display',serif;font-size:1.25rem;line-height:1.75;color:var(--text);font-style:italic;margin-bottom:2rem;">{t.quote}</p>
            <div style="display:flex;align-items:center;justify-content:center;gap:14px;">
              <div class="testimonial-avatar" style="width:56px;height:56px;font-size:1.3rem;">{t.avatar}</div>
              <div style="text-align:left;">
                <strong style="display:block;font-size:1rem;">{t.name}</strong>
                <span style="font-size:.85rem;color:var(--text-light);">{t.role}</span>
                {t.source === 'linkedin' && (
                  <a href={site.linkedin} target="_blank" rel="noopener" style="font-size:.75rem;color:#0A66C2;display:flex;align-items:center;gap:4px;margin-top:4px;">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    Verified on LinkedIn
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LIFE COACHING CLIENTS -->
  <section class="section-sm bg-card">
    <div class="container">
      <div class="section-header center fade-up">
        <p class="section-label">Life Coaching</p>
        <h2>1-on-1 Coaching Clients</h2>
        <p>People who came in feeling stuck, worn out, or unsure what was next — and did the work to come out the other side.</p>
      </div>
      <div class="testimonials-grid" style="margin-top:3rem;">
        {[...featuredPool.filter(t => t.type === 'coaching'), ...coachingClients].map(t => (
          <div class="testimonial-card fade-up">
            <p class="testimonial-quote">{t.quote}</p>
            <div class="testimonial-author">
              <div class="testimonial-avatar">{t.avatar}</div>
              <div class="testimonial-author-info">
                <strong>{t.name}</strong>
                <span>{t.role}</span>
              </div>
            </div>
            {t.source === 'linkedin' && (
              <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);">
                <a href={site.linkedin} target="_blank" rel="noopener" style="font-size:.75rem;color:var(--text-light);display:flex;align-items:center;gap:5px;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  Verified on LinkedIn
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MENTOR COACHING CLIENTS -->
  <section class="section">
    <div class="container">
      <div class="section-header center fade-up">
        <p class="section-label">Mentor Coaching</p>
        <h2>Coaches I've Mentored</h2>
        <p>Coaches in training and practicing coaches who worked with me to sharpen their craft, deepen their presence, and grow their range.</p>
      </div>
      <div class="testimonials-grid" style="margin-top:3rem;">
        {[...featuredPool.filter(t => t.type === 'mentor'), ...mentorClients].map(t => (
          <div class="testimonial-card fade-up">
            <p class="testimonial-quote">{t.quote}</p>
            <div class="testimonial-author">
              <div class="testimonial-avatar">{t.avatar}</div>
              <div class="testimonial-author-info">
                <strong>{t.name}</strong>
                <span>{t.role}</span>
              </div>
            </div>
            {t.source === 'linkedin' && (
              <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);">
                <a href={site.linkedin} target="_blank" rel="noopener" style="font-size:.75rem;color:var(--text-light);display:flex;align-items:center;gap:5px;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  Verified on LinkedIn
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:3rem;" class="fade-up">
        <a href={site.linkedin} target="_blank" rel="noopener" class="btn btn-outline" style="display:inline-flex;align-items:center;gap:8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          See More Reviews on LinkedIn →
        </a>
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <p class="section-label">Your Story Is Next</p>
      <h2>What Would Your Testimonial Say?</h2>
      <p class="poem-line">"My hand is still waiting for yours."</p>
      <p>Book a free discovery call and let's start from wherever you are right now.</p>
      <div class="cta-btns">
        <a href="/contact" class="btn btn-white">Book My Free Call</a>
        <a href="/services" class="btn btn-outline" style="border-color:rgba(250,246,240,.3);color:rgba(250,246,240,.9);">View Services</a>
      </div>
    </div>
  </section>

</Layout>

<script>
  // Show one featured testimonial per week, cycling through the pool
  const cards = document.querySelectorAll<HTMLElement>('#featuredPool [data-fi]');
  if (cards.length) {
    const week = Math.floor(Date.now() / (7 * 24 * 60 * 60 * 1000));
    const idx  = week % cards.length;
    cards[idx].style.display = 'block';
  }
</script>
