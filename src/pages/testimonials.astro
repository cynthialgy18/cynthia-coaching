---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { testimonials } from '../data/testimonials';

const coachingClients = testimonials.filter(t => t.type === 'coaching');
const mentorClients   = testimonials.filter(t => t.type === 'mentor');
---

<Layout title={`Testimonials | ${site.name} — Relational Coach`} description="Real stories from real people — hear what it looks like to feel stuck, do the work, and reconnect to what truly matters.">

  <section class="page-hero">
    <div class="container">
      <p class="section-label">Client Stories</p>
      <h1>Real People. Real Change.</h1>
      <p>These aren't highlight reels — they're honest accounts of what it looks like to do the work and come out the other side.</p>
    </div>
  </section>

  <div class="trust-bar">
    <div class="trust-bar-inner">
      <div class="trust-item">
        <img src="/images/pcc-badge.png" alt="ICF PCC Badge" style="width:44px;height:44px;object-fit:contain;" />
        <div><strong>ICF PCC</strong><span>Accredited</span></div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item"><span class="trust-item-icon">👥</span><div><strong>200+</strong><span>Clients Coached</span></div></div>
      <div class="trust-divider"></div>
      <div class="trust-item"><span class="trust-item-icon">📅</span><div><strong>10+ Years</strong><span>Coaching Since 2015</span></div></div>
    </div>
  </div>

  <!-- ROTATING FEATURED — one per week across ALL testimonials, Monday = week start -->
  <section class="section">
    <div class="container">
      <div class="section-header center fade-up" style="margin-bottom:2rem;">
        <p class="section-label">What Clients Say</p>
      </div>
      <div id="featuredPool">
        {testimonials.map((t, i) => (
          <div
            data-fi={i}
            style="display:none;background:linear-gradient(135deg,#FDF8F3,#F2E9DF);border:1px solid var(--border);border-radius:var(--radius);padding:56px;max-width:860px;margin:0 auto;text-align:center;"
            class="fade-up"
          >
            <div style="font-size:3.5rem;color:var(--accent);line-height:.8;margin-bottom:1rem;">"</div>
            <p style="font-family:'Playfair Display',serif;font-size:1.25rem;line-height:1.8;color:var(--text);font-style:italic;margin-bottom:2rem;">{t.quote}</p>
            <div style="display:flex;align-items:center;justify-content:center;gap:14px;">
              <div class="testimonial-avatar" style="width:56px;height:56px;font-size:1.3rem;">{t.avatar}</div>
              <div style="text-align:left;">
                <strong style="display:block;font-size:1rem;">{t.name}</strong>
                <span style="font-size:.875rem;color:var(--text-light);">{t.role}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 1-ON-1 COACHING CLIENTS -->
  <section class="section-sm bg-card">
    <div class="container">
      <div class="section-header center fade-up">
        <p class="section-label">Relational Coaching</p>
        <h2>1-on-1 Coaching Clients</h2>
        <p>People who came in feeling stuck, worn out, or unsure what was next — and did the work to come out the other side.</p>
      </div>
      <div class="testimonials-grid" style="margin-top:3rem;">
        {coachingClients.map(t => (
          <div class="testimonial-card fade-up">
            <p class="testimonial-quote">{t.quote}</p>
            <div class="testimonial-author">
              <div class="testimonial-avatar">{t.avatar}</div>
              <div class="testimonial-author-info">
                <strong>{t.name}</strong>
                <span>{t.role}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MENTOR COACHING CLIENTS -->
  <section class="section">
    <div class="container">
      <div class="section-header center fade-up">
        <p class="section-label">Mentor Coaching</p>
        <h2>Coaches I've Mentored</h2>
        <p>Coaches in training and practising coaches who worked with me to sharpen their craft, deepen their presence, and grow their range.</p>
      </div>
      <div class="testimonials-grid" style="margin-top:3rem;">
        {mentorClients.map(t => (
          <div class="testimonial-card fade-up">
            <p class="testimonial-quote">{t.quote}</p>
            <div class="testimonial-author">
              <div class="testimonial-avatar">{t.avatar}</div>
              <div class="testimonial-author-info">
                <strong>{t.name}</strong>
                <span>{t.role}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <p class="section-label">Your Story Is Next</p>
      <h2>What Would Your Testimonial Say?</h2>
      <p class="poem-line">"My hand is still waiting for yours."</p>
      <p>Book a discovery call and let's start from wherever you are right now.</p>
      <div class="cta-btns">
        <a href="/contact" class="btn btn-white">Book a Discovery Call</a>
        <a href="/services" class="btn btn-outline" style="border-color:rgba(250,246,240,.3);color:rgba(250,246,240,.9);">View Services</a>
      </div>
    </div>
  </section>

</Layout>

<script>
  // Rotate featured testimonial weekly — Monday = first day of week
  // Unix epoch was a Thursday; first Monday after epoch = Jan 5, 1970 = +4 days
  const MONDAY_EPOCH_OFFSET = 4 * 24 * 60 * 60 * 1000;
  const MS_PER_WEEK = 7 * 24 * 60 * 60 * 1000;
  const cards = document.querySelectorAll<HTMLElement>('#featuredPool [data-fi]');
  if (cards.length) {
    const week = Math.floor((Date.now() - MONDAY_EPOCH_OFFSET) / MS_PER_WEEK);
    const idx  = ((week % cards.length) + cards.length) % cards.length;
    cards[idx].style.display = 'block';
  }
</script>
